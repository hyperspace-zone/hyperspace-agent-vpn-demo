# Hyperspace public pay endpoint.
HYPERSPACE_PAY_BASE=https://app.dev.hyperspace.zone/pay

# Keep true for demo if staging TLS is not fully configured yet. Set false when
# the development hostname certificate is valid end-to-end.
HYPERSPACE_API_INSECURE_TLS=true

# pay.sh compatible CLI settings.
# Hyperspace is not listed in the public pay.sh catalog yet, so the demo calls
# the live MPP / HTTP 402 gateway URL directly and lets pay sign from id.json.
# Local install keeps pay scoped to this demo directory.
PAY_BIN=./node_modules/.bin/pay
PAY_NETWORK=mainnet
PAY_ACCOUNT=hyperspace-agent-demo
PAY_YOLO_UPTO="0.000001 USDC"
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MIN_SOL_FEE_BALANCE=0.00001
MIN_USDC_BALANCE=0.000001

# Wallet must be outside this repository and must contain USDC plus SOL fees.
# Set this to an absolute path before running npm run setup-pay-account.
SOLANA_KEYPAIR_PATH=

# Route: agent runs near Stavanger (SVG), exits near London.
HYPERSPACE_INGRESS_GATE_ID=gate-eu-svg-01
HYPERSPACE_EGRESS_GATE_ID=gate-eu-lon-01
DEMO_CONFIG_NAME=hyperspace-svg-london-agent-demo
PREPAID_DURATION_MINUTES=30
PREPAID_BANDWIDTH_GB=0.1

# IP-to-IP VPN paid config inputs.
# HYPERSPACE_SOURCE_IP must be the stable public egress IPv4 address of this
# server or its NAT gateway. Set it explicitly before buying a config.
HYPERSPACE_SOURCE_IP=
# The paid WireGuard config is issued only for this target IP (/32).
# Default target is lg01-ld4.primexm.com resolved at the time this demo was written.
HYPERSPACE_TARGET_IP=185.97.160.8

# Network diagnostics connect to the same IP-to-IP VPN target.
JITTER_TARGET_HOST=185.97.160.8
JITTER_TARGET_PORT=443
JITTER_SAMPLES=30
JITTER_TIMEOUT_MS=3000
JITTER_INTERVAL_MS=200

# Optional URL timing target.
HTTP_TIMING_URL=https://185.97.160.8/
HTTP_TIMING_INSECURE_TLS=true

# Generated local state. These paths are gitignored.
RUNTIME_DIR=runtime
SESSION_PATH=runtime/session.json
WG_CONFIG_PATH=runtime/hyperspace-demo.conf
# Basename before .conf must be a valid WireGuard interface name: max 15 chars.
WG_CONNECT_CONFIG_PATH=runtime/hsvgdemo.conf
WG_STRIP_DNS=false
# IP-to-IP VPN configs are already target-restricted by the issued AllowedIPs.
# Use "custom" with WG_ALLOWED_IPS only for debugging.
WG_ALLOWED_IPS_MODE=issued
# WG_ALLOWED_IPS=185.97.160.8/32
WG_ALLOW_FULL_TUNNEL_ON_SSH=false
BASELINE_REPORT_PATH=runtime/baseline.json
VPN_REPORT_PATH=runtime/vpn.json
